      },
      "targets": [
        {
          "expr": "100 * (1 - (node_filesystem_avail_bytes{job=\"project1-node\",mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{job=\"project1-node\",mountpoint=\"/\",fstype!=\"rootfs\"}))",
